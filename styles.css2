/* Base Layout & Theme Setup */
:root {
  --default-bg: #1a1a24;
  --default-text: #00f2fe;
  --card-bg: rgba(255, 255, 255, 0.08);
  --accent-color: #008080;
}

body {
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
  background-color: var(--default-bg);
  color: var(--default-text);
  transition: background-color 0.3s, color 0.3s;
}

/* Header Navigation */
.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  background-color: rgba(0, 0, 0, 0.4);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
}

.nav-links a {
  color: inherit;
  text-decoration: none;
  margin-left: 1.5rem;
  font-weight: 500;
}

.nav-links a:hover {
  text-decoration: underline;
}

/* Main Container Layout */
.main-container {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 2rem;
  max-width: 1200px;
  margin: 2rem auto;
  padding: 0 1rem;
}

/* Sidebar & Cards */
.sidebar {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.profile-card, .theme-settings, .card {
  background: var(--card-bg);
  padding: 1.5rem;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.avatar {
  font-size: 3rem;
  text-align: center;
  margin-bottom: 0.5rem;
}

.theme-settings label {
  display: block;
  margin-top: 0.75rem;
  font-size: 0.9rem;
}

.theme-settings input[type="color"] {
  width: 100%;
  height: 40px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  margin-top: 0.25rem;
}

/* Post Creation Area */
.create-post textarea {
  width: 100%;
  height: 80px;
  background: rgba(0, 0, 0, 0.2);
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 4px;
  padding: 0.5rem;
  box-sizing: border-box;
  resize: vertical;
}

.post-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 0.75rem;
}

button {
  background-color: var(--accent-color);
  color: #fff;
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 4px;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  opacity: 0.9;
}

/* Camera Section */
#camera-container {
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

video {
  width: 100%;
  max-width: 400px;
  border-radius: 6px;
  background-color: #000;
}

.hidden {
  display: none !important;
}

/* Feed List */
.feed-container {
  margin-top: 1.5rem;
}

.post-item {
  background: var(--card-bg);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 1rem;
  border-radius: 6px;
  margin-bottom: 1rem;
}

.post-item p {
  margin: 0.5rem 0 0 0;
}

/* Knowledge Archive Search */
.knowledge-search input {
  width: 100%;
  padding: 0.5rem;
  border-radius: 4px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(0, 0, 0, 0.2);
  color: inherit;
  box-sizing: border-box;
}

.results-box {
  margin-top: 1rem;
  min-height: 50px;
}

.placeholder-text {
  font-style: italic;
  opacity: 0.7;
}