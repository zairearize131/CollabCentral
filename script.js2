// Universal App State Engine
document.addEventListener('DOMContentLoaded', () => {
    
    // --- 1. SPA View Router Logic ---
    const navButtons = document.querySelectorAll('[data-view]');
    const viewPanels = document.querySelectorAll('.view-panel');

    navButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            const targetViewId = btn.dataset.view;

            // Update active state on all matching buttons across side/bottom nav
            navButtons.forEach(b => b.classList.remove('active'));
            document.querySelectorAll(`[data-view="${targetViewId}"]`).forEach(b => b.classList.add('active'));

            // Switch view panel visibility
            viewPanels.forEach(panel => {
                if (panel.id === targetViewId) {
                    panel.hidden = false;
                    panel.classList.add('active-view');
                } else {
                    panel.hidden = true;
                    panel.classList.remove('active-view');
                }
            });
        });
    });

    // --- 2. Web Audio API Digital Audio Workstation (DAW) Engine ---
    let audioCtx = null;
    let activeOscillator = null;

    function initAudioContext() {
        if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
    }

    function playNote(frequency) {
        initAudioContext();
        if (activeOscillator) activeOscillator.stop();

        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();

        const waveType = document.getElementById('synthWave').value;
        osc.type = waveType;
        osc.frequency.setValueAtTime(frequency, audioCtx.currentTime);

        gainNode.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 1.2);

        osc.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        osc.start();
        activeOscillator = osc;
    }

    // Attach Piano Key Listeners
    const pianoKeys = document.querySelectorAll('.piano-key');
    pianoKeys.forEach(key => {
        key.addEventListener('click', () => {
            const noteFreq = parseFloat(key.dataset.note);
            playNote(noteFreq);
        });
    });

    // Synth Frequency Slider Control
    const synthFreqInput = document.getElementById('synthFreq');
    const freqValDisplay = document.getElementById('freqVal');
    synthFreqInput.addEventListener('input', (e) => {
        freqValDisplay.textContent = e.target.value;
    });

    document.getElementById('dawPlayBtn').addEventListener('click', () => {
        playNote(parseFloat(synthFreqInput.value));
    });

    document.getElementById('dawStopBtn').addEventListener('click', () => {
        if (activeOscillator) activeOscillator.stop();
    });

    // --- 3. HTML5 Canvas Gaming Arcade Engine ---
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    let gameInterval = null;
    let shieldX = canvas.width / 2;
    let particles = [];

    function drawGame() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Draw Player Shield
        ctx.fillStyle = '#6366f1';
        ctx.fillRect(shieldX - 40, canvas.height - 20, 80, 10);

        // Spawn & Render Particles
        if (Math.random() < 0.05) {
            particles.push({ x: Math.random() * canvas.width, y: 0, speed: 2 + Math.random() * 3 });
        }

        ctx.fillStyle = '#ef4444';
        particles.forEach((p, idx) => {
            p.y += p.speed;
            ctx.beginPath();
            ctx.arc(p.x, p.y, 6, 0, Math.PI * 2);
            ctx.fill();

            // Collision check with shield
            if (p.y >= canvas.height - 20 && Math.abs(p.x - shieldX) < 40) {
                particles.splice(idx, 1);
            }
        });
    }

    canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        shieldX = e.clientX - rect.left;
    });

    document.getElementById('startGameBtn').addEventListener('click', () => {
        if (gameInterval) clearInterval(gameInterval);
        particles = [];
        gameInterval = setInterval(drawGame, 1000 / 60); // 60 FPS
        alert('Arcade Engine running at 60 FPS!');
    });

    // --- 4. WebRTC Camera Live Stream Engine ---
    const toggleCamBtn = document.getElementById('toggleCamBtn');
    const localVideo = document.getElementById('localVideo');
    let streamActive = false;

    toggleCamBtn.addEventListener('click', async () => {
        if (!streamActive) {
            try {
                const mediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                localVideo.srcObject = mediaStream;
                streamActive = true;
                toggleCamBtn.textContent = '⏹ Stop WebRTC Stream';
                toggleCamBtn.classList.replace('btn-danger', 'btn-success');
            } catch (err) {
                alert('Camera/Microphone access required for streaming.');
            }
        } else {
            const stream = localVideo.srcObject;
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
            }
            localVideo.srcObject = null;
            streamActive = false;
            toggleCamBtn.textContent = '📹 Start WebRTC Camera Stream';
            toggleCamBtn.classList.replace('btn-success', 'btn-danger');
        }
    });

    // --- 5. Interactive Chat & Reactions ---
    const sendChatBtn = document.getElementById('sendChatBtn');
    const chatInput = document.getElementById('chatInput');
    const chatBox = document.getElementById('chatBox');

    sendChatBtn.addEventListener('click', () => {
        if (chatInput.value.trim() !== '') {
            const p = document.createElement('p');
            p.className = 'chat-msg';
            p.innerHTML = `<strong>You:</strong> ${chatInput.value}`;
            chatBox.appendChild(p);
            chatInput.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    });

    // Create FAB Trigger
    document.getElementById('fabCreate').addEventListener('click', () => {
        alert('Create Hub Options:\n1. Open Web Audio DAW\n2. Launch WebGL Game Session\n3. Start WebRTC Stream\n4. Upload Video/Photo Post');
    });
});
