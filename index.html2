<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0f172a">
    <meta name="description" content="Ultimate All-in-One Platform: Create Music, Play Games, Stream Live, and Publish Content.">
    <title>OmniMedia Studio | Create, Play, Stream & Publish</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="manifest" href="manifest.json">
</head>
<body>
    <!-- Top Navigation Header -->
    <header class="top-nav">
        <div class="nav-left">
            <span class="brand-logo">⚡ OmniStudio</span>
            <span class="live-indicator">🔴 LIVE PLATFORM</span>
        </div>
        <div class="nav-center">
            <div class="search-wrapper">
                <input type="text" placeholder="Search tracks, games, live streams, or creators..." id="searchInput">
                <button class="search-btn" aria-label="Search">🔍</button>
            </div>
        </div>
        <div class="nav-right">
            <button id="pwaInstallBtn" class="btn btn-accent" hidden>📥 Install PWA</button>
            <button class="icon-btn" id="notifBtn" aria-label="Notifications">🔔<span class="badge">5</span></button>
            <div class="profile-avatar" id="profileBtn" title="Profile & Account Settings">
                <img src="https://picsum.photos/40?random=88" alt="User Avatar">
            </div>
        </div>
    </header>

    <div class="app-layout">
        <!-- Navigation Sidebar (Desktop View) -->
        <aside class="sidebar">
            <nav class="nav-menu">
                <button class="nav-item active" data-view="feedView">
                    <span class="nav-icon">🏠</span> <span class="nav-text">Social Feed</span>
                </button>
                <button class="nav-item" data-view="dawView">
                    <span class="nav-icon">🎛️</span> <span class="nav-text">Music DAW</span>
                </button>
                <button class="nav-item" data-view="gamingView">
                    <span class="nav-icon">🎮</span> <span class="nav-text">Gaming Hub</span>
                </button>
                <button class="nav-item" data-view="streamView">
                    <span class="nav-icon">📹</span> <span class="nav-text">Live Studio</span>
                </button>
                <button class="nav-item" data-view="messagesView">
                    <span class="nav-icon">💬</span> <span class="nav-text">Messages</span>
                </button>
            </nav>
        </aside>

        <!-- Main Content Workspace -->
        <main class="main-content" id="mainContent">

            <!-- VIEW 1: Social & Video Feed (YouTube + Instagram Style) -->
            <section class="view-panel active-view" id="feedView">
                <div class="view-header">
                    <h2>Trending Releases & Stream Highlights</h2>
                </div>
                
                <article class="content-card">
                    <header class="card-header">
                        <img src="https://picsum.photos/40?random=12" alt="Avatar" class="author-avatar">
                        <div class="author-info">
                            <h3>Aria Beats <span class="badge-tag">PRODUCER</span></h3>
                            <p class="post-time">15 mins ago • Published Track</p>
                        </div>
                    </header>
                    <div class="card-body">
                        <p>Just finished publishing my new track entirely created using the in-app DAW! Stems are open for remixing. 🎶🔥</p>
                        <div class="media-container">
                            <img src="https://picsum.photos/800/400?random=22" alt="Post Banner" class="card-media">
                            <span class="media-type-tag">🎵 MUSIC RELEASE</span>
                        </div>
                    </div>
                    <footer class="card-controls">
                        <div class="control-group-left">
                            <button class="action-btn like-btn">❤️ <span class="like-count">342</span></button>
                            <button class="action-btn comment-btn">💬 <span>52 Comments</span></button>
                        </div>
                        <div class="control-group-right">
                            <button class="action-btn save-btn">🔖</button>
                            <button class="action-btn share-btn">📤</button>
                        </div>
                    </footer>
                </article>
            </section>

            <!-- VIEW 2: In-Browser Digital Audio Workstation (DAW) -->
            <section class="view-panel" id="dawView" hidden>
                <div class="view-header">
                    <h2>Web Audio DAW Creator</h2>
                    <div class="daw-global-controls">
                        <button class="btn btn-success" id="dawPlayBtn">▶ Play Synthesizer</button>
                        <button class="btn btn-danger" id="dawStopBtn">⏹ Stop</button>
                        <button class="btn btn-accent" id="publishTrackBtn">🚀 Publish Track</button>
                    </div>
                </div>

                <div class="daw-container">
                    <div class="synth-panel">
                        <h3>Synthesizer Engine (Web Audio API)</h3>
                        <div class="control-grid">
                            <div class="control-node">
                                <label for="synthFreq">Oscillator Pitch (Hz): <span id="freqVal">440</span>Hz</label>
                                <input type="range" id="synthFreq" min="100" max="2000" value="440">
                            </div>
                            <div class="control-node">
                                <label for="synthWave">Waveform Type:</label>
                                <select id="synthWave">
                                    <option value="sine">Sine Wave</option>
                                    <option value="square">Square Wave</option>
                                    <option value="sawtooth">Sawtooth Wave</option>
                                    <option value="triangle">Triangle Wave</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Virtual Piano Keys -->
                    <div class="piano-keyboard">
                        <button class="piano-key" data-note="261.63">C4</button>
                        <button class="piano-key black-key" data-note="277.18">C#4</button>
                        <button class="piano-key" data-note="293.66">D4</button>
                        <button class="piano-key black-key" data-note="311.13">D#4</button>
                        <button class="piano-key" data-note="329.63">E4</button>
                        <button class="piano-key" data-note="349.23">F4</button>
                        <button class="piano-key black-key" data-note="369.99">F#4</button>
                        <button class="piano-key" data-note="392.00">G4</button>
                        <button class="piano-key black-key" data-note="415.30">G#4</button>
                        <button class="piano-key" data-note="440.00">A4</button>
                        <button class="piano-key black-key" data-note="466.16">A#4</button>
                        <button class="piano-key" data-note="493.88">B4</button>
                    </div>
                </div>
            </section>

            <!-- VIEW 3: In-App Gaming Engine View -->
            <section class="view-panel" id="gamingView" hidden>
                <div class="view-header">
                    <h2>HTML5 / WebGL Gaming Hub</h2>
                    <span class="game-status">Matchmaking: Online</span>
                </div>
                <div class="game-wrapper">
                    <canvas id="gameCanvas" width="700" height="400"></canvas>
                    <div class="game-instructions">
                        <p><strong>Controls:</strong> Move your mouse or drag across the canvas to control the player shield. Prevent particles from crossing!</p>
                        <button class="btn btn-accent" id="startGameBtn">🎮 Start Arcade Engine</button>
                    </div>
                </div>
            </section>

            <!-- VIEW 4: WebRTC Interactive Live Streaming View -->
            <section class="view-panel" id="streamView" hidden>
                <div class="view-header">
                    <h2>Live Streaming & Broadcast Studio</h2>
                    <button class="btn btn-danger" id="toggleCamBtn">📹 Start WebRTC Camera Stream</button>
                </div>
                <div class="stream-grid">
                    <div class="video-preview-wrapper">
                        <video id="localVideo" autoplay playsinline muted></video>
                        <span class="stream-badge">WEBRTC LOW-LATENCY</span>
                    </div>
                    <div class="live-chat-panel">
                        <div class="chat-header">Live Chat Stream</div>
                        <div class="chat-messages" id="chatBox">
                            <p class="chat-msg"><strong>System:</strong> Connected to streaming channel.</p>
                            <p class="chat-msg"><strong>User99:</strong> Low latency looks incredible!</p>
                        </div>
                        <div class="chat-input-wrapper">
                            <input type="text" id="chatInput" placeholder="Send a message...">
                            <button id="sendChatBtn" class="btn btn-accent">Send</button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- VIEW 5: Direct Messages View -->
            <section class="view-panel" id="messagesView" hidden>
                <div class="view-header">
                    <h2>Direct Messages & Audio Notes</h2>
                </div>
                <p class="placeholder-text">💬 Select a contact or creator thread to start messaging or voice recording.</p>
            </section>

        </main>
    </div>

    <!-- Central Create Floating Action Button (FAB) -->
    <button class="fab-create" id="fabCreate" aria-label="Create Content">
        <span>+</span>
    </button>

    <!-- Sticky Media Player Dock -->
    <div class="media-player-dock" id="playerDock">
        <div class="track-info">
            <img src="https://picsum.photos/50?random=90" alt="Thumb" class="dock-thumb">
            <div class="track-details">
                <span class="track-title">Cybernetic Revolution</span>
                <span class="track-artist">Live Collaboration Stream</span>
            </div>
        </div>
        <div class="dock-controls">
            <button class="player-btn">⏮️</button>
            <button class="player-btn play-pause-btn" id="dockPlayBtn">▶️</button>
            <button class="player-btn">⏭️</button>
        </div>
        <div class="dock-settings">
            <select class="quality-select">
                <option value="1080p">1080p Stream</option>
                <option value="720p">720p</option>
                <option value="audio">Audio Only</option>
            </select>
            <input type="range" min="0" max="100" value="80" class="volume-slider">
        </div>
    </div>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="bottom-nav">
        <button class="bottom-nav-item active" data-view="feedView">
            <span class="nav-icon">🏠</span>
            <span class="nav-text">Feed</span>
        </button>
        <button class="bottom-nav-item" data-view="dawView">
            <span class="nav-icon">🎛️</span>
            <span class="nav-text">DAW</span>
        </button>
        <div class="fab-spacer"></div>
        <button class="bottom-nav-item" data-view="gamingView">
            <span class="nav-icon">🎮</span>
            <span class="nav-text">Gaming</span>
        </button>
        <button class="bottom-nav-item" data-view="streamView">
            <span class="nav-icon">📹</span>
            <span class="nav-text">Stream</span>
        </button>
    </nav>

    <script src="app.js"></script>
</body>
</html>
